GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://restless-24-7.onrender.com/google/callback
SECRET_KEY=replace-with-a-strong-random-secret
SESSION_SECRET=replace-with-a-strong-random-session-secret
DATABASE_URL=postgresql://user:password@host:5432/restless
FLASK_ENV=development
APP_URL=http://localhost:5000

# Initial mixer bootstrap passwords. Set these in the local environment before
# creating the default mixer accounts; never commit real values to the repo.
MIXER_SLEEZE_PASSWORD=
MIXER_KAYC_PASSWORD=
MIXER_PPO_PASSWORD=
MIXER_BOA_PASSWORD=
