<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RESTLESS STUDIO | 24/7 Studio & Mix</title>
    <link rel="icon" type="image/png" href="logo.png">
    <link rel="shortcut icon" type="image/png" href="logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Orbitron:wght@600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #05070b;
            --bg-deep: #0b0d13;
            --bg-card: rgba(255, 255, 255, 0.025);
            --text-main: #f5f7ff;
            --text-muted: #a0a7b8;
            --accent-neon: #8b5cf6;
            --accent-bright: #c7b3ff;
            --accent-glow: rgba(139, 92, 246, 0.28);
            --accent-violet: #6d3ef0;
            --border-soft: rgba(255, 255, 255, 0.08);
            --surface-elevated: rgba(255, 255, 255, 0.025);
            --shadow-soft: 0 26px 70px rgba(0, 0, 0, 0.45);
            --shadow-accent: 0 0 0 1px rgba(185, 160, 255, 0.12), 0 22px 60px rgba(109, 62, 240, 0.12);
            --radius-lg: 26px;
            --radius-md: 18px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 90px;
        }

        body {
            --mouse-x: 0px;
            --mouse-y: 0px;
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            line-height: 1.6;
            overflow-x: hidden;
            position: relative;
            scroll-behavior: smooth;
            background-image:
                radial-gradient(circle at top left, rgba(109, 62, 240, 0.12), transparent 26%),
                radial-gradient(circle at bottom right, rgba(109, 62, 240, 0.08), transparent 32%),
                linear-gradient(180deg, rgba(255,255,255,0.012) 0%, rgba(0,0,0,0.18) 100%),
                repeating-linear-gradient(
                    90deg,
                    rgba(255,255,255,0.008) 0,
                    rgba(255,255,255,0.008) 1px,
                    transparent 1px,
                    transparent 130px
                ),
                repeating-linear-gradient(
                    0deg,
                    rgba(255,255,255,0.01) 0,
                    rgba(255,255,255,0.01) 1px,
                    transparent 1px,
                    transparent 170px
                ),
                linear-gradient(180deg, #030507 0%, #090d13 26%, #0b0d12 100%);
            padding-top: 68px;
            cursor: default;
        }

        body::before {
            content: "";
            position: fixed;
            inset: -18% auto auto -8%;
            width: 40vw;
            height: 40vw;
            max-width: 620px;
            max-height: 620px;
            background: radial-gradient(circle, rgba(168, 85, 247, 0.36), rgba(124, 58, 237, 0.12) 35%, transparent 72%);
            filter: blur(120px);
            pointer-events: none;
            z-index: 0;
            animation: driftGlow 18s ease-in-out infinite alternate;
        }

        body::after {
            content: "";
            position: fixed;
            right: -8%;
            bottom: -12%;
            width: 46vw;
            height: 46vw;
            max-width: 760px;
            max-height: 760px;
            background: radial-gradient(circle, rgba(90, 70, 160, 0.18), rgba(90, 70, 160, 0.04) 32%, transparent 72%);
            filter: blur(160px);
            pointer-events: none;
            z-index: 0;
            animation: driftGlowAlt 22s ease-in-out infinite alternate;
        }

        .mouse-glow {
            position: fixed;
            left: 0;
            top: 0;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(210, 180, 255, 0.28), rgba(168, 85, 247, 0.16) 28%, rgba(168, 85, 247, 0.06) 48%, rgba(168, 85, 247, 0.02) 66%, transparent 80%);
            filter: blur(24px);
            pointer-events: none;
            z-index: 0;
            transform: translate3d(-50%, -50%, 0) scale(1.04);
            opacity: 0.8;
            transition: opacity 0.2s ease, filter 0.2s ease, transform 0.18s ease;
            mix-blend-mode: screen;
            will-change: transform, opacity;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        img {
            display: block;
            max-width: 100%;
        }

        button,
        input,
        select,
        textarea {
            font: inherit;
        }

        .container {
            width: min(1200px, calc(100% - 32px));
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }

        .section {
            padding: 110px 0;
            position: relative;
            z-index: 1;
        }

        .section-alt {
            background: linear-gradient(180deg, rgba(255,255,255,0.012), rgba(255,255,255,0.005));
            border-top: 1px solid rgba(255,255,255,0.05);
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .eyebrow {
            font-size: 11px;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--text-muted);
            font-weight: 700;
        }

        h1, h2, h3, h4, .brand-word, .btn-primary, .btn-secondary {
            font-family: 'Orbitron', sans-serif;
            letter-spacing: -0.04em;
        }
    </style>
</head>
<body>
    <p>Backup created.</p>
</body>
</html>
